:root {
    --ink: #19332d;
    --forest: #173c32;
    --deep: #102b26;
    --cream: #f7f5ef;
    --sand: #e8e3d8;
    --muted: #73786e;
    --saffron: #d98e55;
    --serif: "Playfair Display", Georgia, serif;
    --sans: "DM Sans", Arial, sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 84px; }
body { margin: 0; background: var(--cream); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
img { display: block; max-width: 100%; }
a { color: inherit; text-decoration: none; }
button, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
.page-wrap { width: min(1240px, calc(100% - 112px)); margin: 0 auto; }
.skip-link { position: fixed; z-index: 100; top: 12px; left: 12px; padding: 12px 18px; transform: translateY(-160%); color: white; background: var(--deep); }
.skip-link:focus { transform: translateY(0); }

.site-header { position: absolute; z-index: 10; inset: 0 0 auto; color: white; transition: background .25s, color .25s, box-shadow .25s; }
.site-header.scrolled { position: fixed; color: var(--ink); background: rgba(247,245,239,.96); box-shadow: 0 1px 15px rgba(18,38,31,.08); backdrop-filter: blur(12px); }
.nav-shell { width: min(1400px, calc(100% - 112px)); height: 88px; margin: auto; display: flex; align-items: center; justify-content: space-between; }
.brand { display: inline-flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 700; letter-spacing: -.8px; white-space: nowrap; }
.brand-mark { display: grid; width: 29px; height: 29px; place-items: center; border: 1px solid currentColor; border-radius: 50%; color: var(--saffron); font-size: 17px; }
.brand-light { font-weight: 400; }
.nav-links { display: flex; align-items: center; gap: clamp(22px, 3.3vw, 48px); font-size: 12px; font-weight: 500; letter-spacing: .03em; }
.nav-links > a:not(.nav-cta) { transition: opacity .2s; }
.nav-links > a:not(.nav-cta):hover { opacity: .7; }
.nav-cta { display: inline-flex; align-items: center; gap: 12px; padding: 13px 18px; border: 1px solid rgba(255,255,255,.55); border-radius: 2px; transition: background .2s,color .2s; }
.nav-cta:hover { color: var(--ink); background: white; }
.scrolled .nav-cta { border-color: var(--ink); }
.scrolled .nav-cta:hover { color: white; background: var(--ink); }
.menu-toggle { display: none; }

.hero { position: relative; min-height: 700px; height: min(850px, 100svh); display: flex; align-items: center; overflow: hidden; color: white; background: var(--deep); }
.hero-image, .hero-shade { position: absolute; inset: 0; }
.hero-image { background: url("https://images.unsplash.com/photo-1524492412937-b28074a5d7da?auto=format&fit=crop&w=2200&q=90") center 54% / cover; animation: hero-zoom 18s ease-out both; }
.hero-shade { background: linear-gradient(90deg, rgba(11,29,26,.76) 0%, rgba(11,29,26,.48) 43%, rgba(11,29,26,.08) 100%), linear-gradient(0deg, rgba(11,29,26,.34), transparent 26%); }
.hero-content { position: relative; z-index: 1; padding-top: 48px; }
.eyebrow { margin: 0 0 24px; color: rgba(255,255,255,.72); font-size: 10px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
.hero-eyebrow { display: flex; align-items: center; gap: 10px; }
.hero-eyebrow span { width: 6px; height: 6px; border-radius: 50%; background: var(--saffron); }
.hero h1, h2 { font-family: var(--serif); font-weight: 500; letter-spacing: -.04em; }
.hero h1 { margin: 0; font-size: clamp(74px, 10vw, 144px); line-height: .9; }
.hero h1 em, h2 em { font-weight: 500; }
.hero-copy { margin: 29px 0 30px; color: rgba(255,255,255,.81); font-size: 15px; line-height: 1.8; }
.button { display: inline-flex; min-height: 50px; align-items: center; justify-content: center; gap: 28px; padding: 0 21px; border: 1px solid transparent; border-radius: 2px; font-size: 11px; font-weight: 600; letter-spacing: .03em; cursor: pointer; transition: transform .2s, background .2s, color .2s; }
.button:hover { transform: translateY(-2px); }
.button-light { color: var(--ink); background: var(--cream); }
.button-light:hover { background: white; }
.hero-foot { position: absolute; z-index: 1; right: 0; bottom: 29px; left: 0; display: flex; justify-content: space-between; align-items: center; color: rgba(255,255,255,.73); font-size: 9px; letter-spacing: .16em; }
.hero-scroll { display: flex; align-items: center; gap: 12px; }
.scroll-line { width: 36px; height: 1px; background: var(--saffron); }
.hero-side-note { position: absolute; z-index: 1; top: 49%; right: 27px; display: flex; gap: 16px; color: rgba(255,255,255,.75); font-size: 9px; letter-spacing: .15em; writing-mode: vertical-rl; text-transform: uppercase; }
@keyframes hero-zoom { from { transform: scale(1.05); } to { transform: scale(1); } }

.intro { padding-top: 125px; padding-bottom: 110px; }
.eyebrow-dark { color: #8b735e; }
.intro .eyebrow { margin-bottom: 25px; }
.intro-row { display: grid; grid-template-columns: 1.2fr .8fr; gap: 12%; align-items: end; }
.intro h2, .section-heading h2, .experience-heading h2 { margin: 0; font-size: clamp(43px, 5.3vw, 70px); line-height: 1.08; }
.intro h2 em, .section-heading h2 em, .experience-heading h2 em { color: #9b6848; }
.intro-row > p { max-width: 385px; margin: 0 0 5px; color: #697069; font-size: 14px; line-height: 1.9; }

.section-pad { padding: 104px 0 112px; }
.destinations { background: #eeece5; }
.section-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 45px; }
.section-heading .eyebrow { margin-bottom: 20px; }
.section-heading h2 { font-size: clamp(42px, 5vw, 64px); }
.text-link { display: inline-flex; align-items: center; gap: 20px; padding-bottom: 8px; border-bottom: 1px solid #a8a69b; font-size: 11px; font-weight: 600; white-space: nowrap; transition: gap .2s; }
.text-link:hover { gap: 27px; }
.destination-grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 19px; align-items: start; }
.place-card { position: relative; min-height: 400px; height: 34vw; max-height: 480px; overflow: hidden; color: white; background: #6c766b; }
.place-card-tall { height: calc(34vw + 55px); max-height: 535px; }
.place-card::after { position: absolute; inset: 0; content: ""; background: linear-gradient(0deg, rgba(10,24,21,.8), transparent 55%); transition: background .3s; }
.place-card:hover img { transform: scale(1.045); }
.place-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .65s cubic-bezier(.2,.7,.2,1); }
.place-number { position: absolute; z-index: 1; top: 22px; left: 22px; display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid rgba(255,255,255,.63); border-radius: 50%; font-size: 9px; }
.place-info { position: absolute; z-index: 1; right: 24px; bottom: 25px; left: 24px; display: flex; flex-direction: column; align-items: flex-start; }
.place-info > span:first-child { margin-bottom: 11px; color: rgba(255,255,255,.77); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; }
.place-info strong { font-family: var(--serif); font-size: clamp(25px, 2.7vw, 38px); font-weight: 500; line-height: 1.06; }
.place-arrow { position: absolute; right: 0; bottom: 3px; font-size: 18px; transition: transform .2s; }
.place-card:hover .place-arrow { transform: translate(3px,-3px); }

.quote-band { position: relative; display: flex; min-height: 590px; align-items: center; overflow: hidden; color: white; background: var(--deep); }
.quote-image, .quote-overlay { position: absolute; inset: 0; }
.quote-image { background: url("https://images.unsplash.com/photo-1599661046827-dacff0c0f09a?auto=format&fit=crop&w=2100&q=85") center 52% / cover; }
.quote-overlay { background: linear-gradient(90deg, rgba(15,39,33,.88), rgba(15,39,33,.5) 52%, rgba(15,39,33,.14)); }
.quote-content { position: relative; z-index: 1; max-width: 1240px; }
.quote-content .eyebrow { margin-bottom: 25px; }
.quote-content h2, .planner h2 { margin: 0; font-size: clamp(50px, 6.4vw, 82px); line-height: 1.02; }
.quote-content h2 em, .planner h2 em { color: #e6b58d; }
.quote-content > p:not(.eyebrow) { max-width: 440px; margin: 24px 0 27px; color: rgba(255,255,255,.8); font-size: 13px; line-height: 1.9; }
.button-outline { color: white; background: transparent; border-color: rgba(255,255,255,.57); }
.button-outline:hover { color: var(--ink); background: white; }
.quote-caption { position: absolute; right: 34px; bottom: 34px; color: rgba(255,255,255,.63); font-size: 9px; letter-spacing: .17em; writing-mode: vertical-rl; }

.experiences { background: var(--cream); }
.experience-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 11%; align-items: center; }
.experience-heading .eyebrow { margin-bottom: 20px; }
.experience-heading h2 { font-size: clamp(42px, 4.5vw, 60px); }
.experience-heading > p:not(.eyebrow) { max-width: 330px; margin: 23px 0 27px; color: #73786e; font-size: 13px; line-height: 1.8; }
.experience-list { border-top: 1px solid #d9d6cd; }
.experience-item { display: grid; grid-template-columns: 42px 1fr 24px; gap: 17px; align-items: start; padding: 27px 0; border-bottom: 1px solid #d9d6cd; }
.experience-icon { padding-top: 3px; color: #a07b60; font-family: var(--serif); font-size: 17px; }
.experience-item h3 { margin: 0 0 7px; font-family: var(--serif); font-size: 23px; font-weight: 500; }
.experience-item p { max-width: 390px; margin: 0; color: #73786e; font-size: 12px; line-height: 1.8; }
.experience-symbol { padding-top: 5px; font-size: 16px; }

.journal { background: #eeece5; }
.journal-heading { align-items: end; }
.journal-note { margin: 0 0 8px; color: #73786e; font-size: 12px; line-height: 1.8; }
.gallery-grid { display: grid; grid-template-columns: 1.35fr 1fr 1fr; gap: 17px; }
.gallery-tile { position: relative; height: 320px; padding: 0; border: 0; overflow: hidden; color: white; text-align: left; background: #9b9b87; cursor: zoom-in; }
.gallery-tile::after { position: absolute; inset: 40% 0 0; content: ""; background: linear-gradient(0deg, rgba(13,30,24,.63), transparent); }
.gallery-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
.gallery-tile:hover img { transform: scale(1.04); }
.gallery-tile > span { position: absolute; z-index: 1; bottom: 20px; left: 20px; font-size: 9px; font-weight: 600; letter-spacing: .15em; }

.planner { padding: 88px 0; color: white; background: var(--forest); }
.planner-inner { display: grid; grid-template-columns: 1fr .8fr; gap: 10%; align-items: center; }
.planner .eyebrow { margin-bottom: 20px; }
.planner h2 { font-size: clamp(47px, 5.7vw, 70px); }
.planner-form { padding: 27px; color: var(--ink); background: var(--cream); }
.planner-form label { display: block; margin-bottom: 15px; font-family: var(--serif); font-size: 19px; }
.planner-controls { display: flex; gap: 9px; }
.planner-controls select { min-width: 0; flex: 1; height: 50px; padding: 0 13px; border: 1px solid #dad8d0; border-radius: 2px; color: var(--ink); background: white; font-size: 11px; }
.button-dark { color: white; background: var(--forest); }
.button-dark:hover { background: var(--deep); }
.form-message { min-height: 16px; margin: 10px 0 0; color: #596a56; font-size: 11px; }

.site-footer { color: white; background: #102923; }
.footer-main { display: grid; grid-template-columns: 1.4fr .8fr .8fr; gap: 50px; padding-top: 62px; padding-bottom: 55px; }
.footer-brand { font-size: 18px; }
.footer-about p, .footer-note p { margin: 18px 0 0; color: rgba(255,255,255,.66); font-size: 11px; line-height: 1.9; }
.footer-label { display: block; margin: 5px 0 18px; color: #d5aa81; font-size: 9px; letter-spacing: .15em; }
.footer-links { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; font-size: 11px; }
.footer-links .footer-label { margin-bottom: 5px; }
.footer-links a, .footer-note a { color: rgba(255,255,255,.8); }
.footer-links a:hover, .footer-note a:hover { color: white; }
.footer-note a { display: inline-block; margin-top: 14px; font-size: 10px; }
.footer-bottom { display: flex; justify-content: space-between; padding-top: 18px; padding-bottom: 18px; border-top: 1px solid rgba(255,255,255,.17); color: rgba(255,255,255,.54); font-size: 8px; letter-spacing: .14em; }
.footer-bottom a { color: rgba(255,255,255,.74); }

.lightbox { position: fixed; width: min(1000px, calc(100% - 32px)); max-width: none; max-height: 90vh; padding: 12px; border: 0; background: #102923; box-shadow: 0 18px 70px rgba(0,0,0,.35); }
.lightbox::backdrop { background: rgba(7,18,15,.84); backdrop-filter: blur(5px); }
.lightbox img { width: 100%; max-height: calc(90vh - 24px); object-fit: contain; }
.lightbox-close { position: absolute; top: 20px; right: 20px; z-index: 1; width: 40px; height: 40px; border: 0; border-radius: 50%; color: var(--ink); background: white; font-size: 25px; cursor: pointer; }

:focus-visible { outline: 2px solid #d98e55; outline-offset: 4px; }
@media (max-width: 900px) {
    .page-wrap, .nav-shell { width: calc(100% - 56px); }
    .nav-links { gap: 20px; }
    .destination-grid { grid-template-columns: 1fr 1fr; }
    .place-card, .place-card-tall { height: 420px; max-height: none; }
    .place-card:first-child { grid-row: span 2; height: 100%; min-height: 600px; }
    .experience-layout { gap: 7%; }
    .gallery-tile { height: 260px; }
    .quote-band { min-height: 540px; }
}
@media (max-width: 680px) {
    html { scroll-padding-top: 70px; }
    .page-wrap { width: calc(100% - 40px); }
    .nav-shell { width: calc(100% - 40px); height: 70px; }
    .brand { font-size: 18px; }
    .menu-toggle { display: flex; width: 42px; height: 42px; flex-direction: column; justify-content: center; align-items: center; gap: 6px; border: 1px solid rgba(255,255,255,.45); border-radius: 50%; color: inherit; background: transparent; cursor: pointer; }
    .menu-toggle span { width: 16px; height: 1px; background: currentColor; transition: transform .2s; }
    .menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
    .scrolled .menu-toggle { border-color: rgba(25,51,45,.4); }
    .nav-links { position: absolute; top: 70px; right: 0; left: 0; display: none; align-items: stretch; gap: 0; padding: 8px 20px 20px; color: var(--ink); background: var(--cream); box-shadow: 0 14px 22px rgba(17,38,31,.12); }
    .nav-links.open { display: flex; flex-direction: column; }
    .nav-links > a:not(.nav-cta) { padding: 14px 4px; border-bottom: 1px solid #dfddd5; }
    .nav-cta { justify-content: space-between; margin-top: 14px; border-color: var(--ink); }
    .hero { min-height: 650px; height: 90svh; max-height: 790px; }
    .hero-image { background-position: 57% center; }
    .hero-shade { background: linear-gradient(90deg, rgba(11,29,26,.66), rgba(11,29,26,.12)), linear-gradient(0deg, rgba(11,29,26,.3), transparent 38%); }
    .hero-content { padding-top: 28px; }
    .hero-eyebrow { max-width: 270px; font-size: 8px; line-height: 1.7; }
    .hero h1 { font-size: clamp(74px, 18vw, 110px); }
    .hero-copy { font-size: 13px; }
    .hero-foot { bottom: 22px; font-size: 7px; }
    .hero-foot > span:last-child, .hero-side-note { display: none; }
    .intro { padding-top: 80px; padding-bottom: 75px; }
    .intro-row { grid-template-columns: 1fr; gap: 20px; }
    .intro h2 { font-size: 46px; }
    .intro-row > p { font-size: 13px; }
    .section-pad { padding: 75px 0; }
    .section-heading { align-items: flex-start; flex-direction: column; margin-bottom: 29px; }
    .section-heading h2 { font-size: 43px; }
    .section-heading .eyebrow { margin-bottom: 15px; }
    .destination-grid { grid-template-columns: 1fr; gap: 13px; }
    .place-card, .place-card-tall, .place-card:first-child { grid-row: auto; height: 390px; min-height: 0; }
    .place-info strong { font-size: 33px; }
    .quote-band { min-height: 575px; }
    .quote-image { background-position: 58% center; }
    .quote-overlay { background: linear-gradient(90deg, rgba(15,39,33,.83), rgba(15,39,33,.32)), linear-gradient(0deg, rgba(15,39,33,.35), transparent); }
    .quote-content h2, .planner h2 { font-size: 53px; }
    .quote-content > p:not(.eyebrow) { font-size: 12px; }
    .quote-caption { right: 15px; bottom: 20px; font-size: 7px; }
    .experience-layout { grid-template-columns: 1fr; gap: 38px; }
    .experience-heading h2 { font-size: 46px; }
    .experience-item { grid-template-columns: 30px 1fr 18px; gap: 12px; padding: 22px 0; }
    .experience-item h3 { font-size: 21px; }
    .experience-item p { font-size: 11px; }
    .journal-note { margin-top: -10px; }
    .gallery-grid { grid-template-columns: 1fr 1fr; gap: 11px; }
    .gallery-tile, .gallery-wide { height: 190px; }
    .gallery-wide { grid-column: span 2; }
    .gallery-tile > span { bottom: 13px; left: 12px; font-size: 7px; }
    .planner { padding: 68px 0; }
    .planner-inner { grid-template-columns: 1fr; gap: 31px; }
    .planner h2 { font-size: 53px; }
    .planner-form { padding: 20px; }
    .planner-controls { flex-direction: column; }
    .planner-controls .button { width: 100%; }
    .footer-main { grid-template-columns: 1fr 1fr; gap: 32px 20px; padding-top: 48px; padding-bottom: 40px; }
    .footer-about { grid-column: span 2; }
    .footer-note p br { display: none; }
    .footer-bottom { flex-wrap: wrap; gap: 12px; font-size: 7px; }
}
@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
